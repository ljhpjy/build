# ---------------------------------------------------------------------------
# 手机版预置配置（打进 APK，可在 /admin 后台直接修改）
# 引擎 auto：有 token + ds-pow 就直连，否则回退 Playwright 浏览器引擎——完整双引擎
# ---------------------------------------------------------------------------
ENGINE=auto
POW_BIN=bin/ds-pow
DEEPSEEK_BASE_URL=https://chat.deepseek.com

DEEPSEEK_THINKING=always
DEEPSEEK_SEARCH=false
DEEPSEEK_MANAGE_TOGGLES=true
DEFAULT_MODEL=deepseek-flash

# 直连模式设备画像（选定后长期固定）
DEEPSEEK_DEVICE_PROFILE=chrome-win
DEEPSEEK_COLD_START=true
DEEPSEEK_HUMAN_TIMING=true

# 服务
HOST=127.0.0.1
PORT=8787
API_KEY=
CORS_ORIGIN=*
LOG_LEVEL=info

# 浏览器引擎：proot 里的 Playwright Chromium（arm64）
BROWSER_HEADLESS=true
CHROMIUM_EXECUTABLE=/opt/chromium/chrome
CHROMIUM_DEPS_DIR=
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900
BROWSER_LOCALE=zh-CN
# proot 下不要 zygote，配合项目自带的 no-sandbox/disable-gpu/disable-dev-shm-usage
BROWSER_ARGS=--no-zygote --disable-setuid-sandbox --disable-infobars

# 运行（手机内存有限，并发保持 1）
CONCURRENCY=1
QUEUE_LIMIT=64
REQUEST_TIMEOUT_MS=240000
FIRST_TOKEN_TIMEOUT_MS=90000
POLL_INTERVAL_MS=60
SETTLE_MS=800
SEND_INTERVAL_MS=4000
DIRECT_SEND_INTERVAL_MS=0
ACCOUNT_COOLDOWN_MS=60000
MAX_COOLDOWN_WAIT_MS=5000
REASONING_HOLD_MS=900
RATE_LIMIT_BACKOFF_MS=4000
IDLE_SHUTDOWN_MS=900000
WARMUP=true
BROWSER_CAPTURE=true
BROWSER_CAPTURE_WAIT_MS=20000
MAX_PROMPT_CHARS=100000
MAX_ATTACHMENT_CHARS=2000000
OVERFLOW_TO_ATTACHMENT=true
SAVE_ARTIFACTS=true
