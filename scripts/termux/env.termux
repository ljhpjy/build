# ---------------------------------------------------------------------------
# fuckds · Termux 预置配置（由 GitHub Actions 打进原生包）
# 所有值都有默认值，只有 DEEPSEEK userToken 是必须的（用 ./fuckds auth 写入 data/auth.json）
# ---------------------------------------------------------------------------

# 引擎：auto = 有 token + bin/ds-pow 就直连，否则回退 browser（Playwright + Chromium）
# direct 最快、功能最全（图片 / 超长上下文转附件 / 号池）；browser 需要 pkg install chromium
ENGINE=auto
POW_BIN=bin/ds-pow
DEEPSEEK_BASE_URL=https://chat.deepseek.com

DEEPSEEK_THINKING=always
DEEPSEEK_SEARCH=false
DEEPSEEK_MANAGE_TOGGLES=true
DEFAULT_MODEL=deepseek-flash

# 直连模式的设备画像与行为伪装（选定后请长期固定）
DEEPSEEK_DEVICE_PROFILE=chrome-win
DEEPSEEK_COLD_START=true
DEEPSEEK_HUMAN_TIMING=true

# ---------------------------- 服务 ----------------------------
HOST=127.0.0.1
PORT=8787
# 设置后，OpenAI / Anthropic / 后台接口都要求 Authorization: Bearer <API_KEY>
API_KEY=
CORS_ORIGIN=*
LOG_LEVEL=info

# ---------------------------- 浏览器引擎 ----------------------------
# 用 Termux 官方 Chromium；启动器会自动探测并导出 CHROMIUM_EXECUTABLE。
# 如果自动探测失败，在这里写绝对路径，例如：
# CHROMIUM_EXECUTABLE=/data/data/com.termux/files/usr/bin/chromium
BROWSER_HEADLESS=true
CHROMIUM_DEPS_DIR=
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900
BROWSER_LOCALE=zh-CN
# Termux/Android 下不要 zygote；启动器也会默认补上同样的开关
BROWSER_ARGS=--no-zygote --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu --disable-infobars

# ---------------------------- 运行 ----------------------------
# 手机内存有限，保持 1；要跑多账号并发再调大
CONCURRENCY=1
QUEUE_LIMIT=64
REQUEST_TIMEOUT_MS=240000
FIRST_TOKEN_TIMEOUT_MS=90000
POLL_INTERVAL_MS=60
SETTLE_MS=800
SEND_INTERVAL_MS=4000
DIRECT_SEND_INTERVAL_MS=0
ACCOUNT_COOLDOWN_MS=60000
MAX_COOLDOWN_WAIT_MS=5000
REASONING_HOLD_MS=900
RATE_LIMIT_BACKOFF_MS=4000
IDLE_SHUTDOWN_MS=900000
WARMUP=true
BROWSER_CAPTURE=true
BROWSER_CAPTURE_WAIT_MS=20000
MAX_PROMPT_CHARS=100000
MAX_ATTACHMENT_CHARS=2000000
OVERFLOW_TO_ATTACHMENT=true
SAVE_ARTIFACTS=true
