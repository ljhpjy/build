<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/tab_env"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="环境" />

        <Button
            android:id="@+id/tab_svc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="服务" />

        <Button
            android:id="@+id/tab_acct"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="账号" />

        <Button
            android:id="@+id/tab_cfg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="配置" />

        <Button
            android:id="@+id/tab_log"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="日志" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 环境：导入 rootfs -->
        <LinearLayout
            android:id="@+id/panel_env"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/env_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:typeface="monospace"
                android:scrollbars="vertical"
                android:text="正在准备…" />

            <TextView
                android:id="@+id/import_pct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="18sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:text="0.0%" />

            <ProgressBar
                android:id="@+id/import_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="导入 fuckds-rootfs.tar.xz" />
        </LinearLayout>

        <!-- 服务：启停 / 状态 / 控制台 -->
        <LinearLayout
            android:id="@+id/panel_svc"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <TextView
                android:id="@+id/svc_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="12sp"
                android:typeface="monospace"
                android:scrollbars="vertical"
                android:text="尚未启动" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启动服务" />

                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="停止服务" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="刷新运行详情" />

            <Button
                android:id="@+id/btn_open"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="打开网页控制台（浏览器）" />

            <Button
                android:id="@+id/btn_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="复制 API 地址（给其它客户端用）" />
        </LinearLayout>

        <!-- 账号：token 号池管理 -->
        <LinearLayout
            android:id="@+id/panel_acct"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <EditText
                android:id="@+id/acct_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:gravity="top"
                android:hint="粘贴 userToken（多个用空格/换行分隔）" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/acct_replace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="替换全部" />

                <Button
                    android:id="@+id/acct_append"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="追加" />

                <Button
                    android:id="@+id/acct_verify"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="校验" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/acct_index"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="要删除的序号" />

                <Button
                    android:id="@+id/acct_remove"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="删除" />

                <Button
                    android:id="@+id/acct_refresh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="刷新列表" />
            </LinearLayout>

            <TextView
                android:id="@+id/acct_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="11sp"
                android:typeface="monospace"
                android:scrollbars="vertical"
                android:text="" />
        </LinearLayout>

        <!-- 配置：引擎 / API Key / 并发 -->
        <LinearLayout
            android:id="@+id/panel_cfg"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <EditText
                android:id="@+id/cfg_engine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ENGINE：direct / auto / browser" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/cfg_host"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="HOST（默认 127.0.0.1）" />

                <EditText
                    android:id="@+id/cfg_port"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:inputType="number"
                    android:hint="PORT（留空=自动 18787）" />
            </LinearLayout>

            <EditText
                android:id="@+id/cfg_apikey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="API_KEY（留空=不鉴权）" />

            <EditText
                android:id="@+id/cfg_concurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="CONCURRENCY（并发，默认 1）" />

            <Button
                android:id="@+id/cfg_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="读取当前配置" />

            <Button
                android:id="@+id/cfg_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="保存配置" />

            <Button
                android:id="@+id/cfg_restart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="重启服务（使配置生效）" />

            <TextView
                android:id="@+id/cfg_info"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="11sp"
                android:typeface="monospace"
                android:scrollbars="vertical"
                android:text="" />
        </LinearLayout>

        <!-- 日志 -->
        <LinearLayout
            android:id="@+id/panel_log"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/log_server"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="服务日志(API)" />

                <Button
                    android:id="@+id/log_local"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="启动日志(本地)" />
            </LinearLayout>

            <TextView
                android:id="@+id/log_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:textSize="10sp"
                android:typeface="monospace"
                android:scrollbars="vertical"
                android:text="" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
